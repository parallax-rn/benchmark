{
  "_comment": "Plan 0023's arms. Each arm runs with its own CLAUDE_CONFIG_DIR (~/ParallaxBench/arms/<id>/claude, made in R1.3 by the tool's own setup) and copies ~/ParallaxBench/arms/<id>/project over the run folder after the reset (what the tool's setup writes into a project). The base tools and denials are the same for every arm: Skill allowed (every tool's own skills can load; Skill(parallax) stays denied outside the A3 arms), subagents allowed (Task and Agent; maintainer, 2026-11-11: a run's totals add each subagent's own transcript). `settings`: passed as --settings; skillOverrides parallax off hides the account's synced parallax skill from the non-A3 arms (maintainer, 2026-11-11, option c); it was added for the reruns of the 9 flagged runs, so the other counted runs of R1's rerun ran without it (the skill listed, never called). `path`: bin folders (relative to the bench root) put first on the agent's PATH.",
  "base": {
    "allowedTools": ["Read", "Edit", "Write", "MultiEdit", "Glob", "Grep", "Bash", "TodoWrite", "Skill"],
    "disallowedTools": ["Bash(git:*)", "WebFetch", "WebSearch"]
  },
  "arms": {
    "A0": { "name": "no device tool", "allowedTools": [], "disallowedTools": ["Skill(parallax)"] },
    "A1": { "name": "agent-device", "allowedTools": ["mcp__agent-device__*"], "disallowedTools": ["Skill(parallax)"] },
    "A2": { "name": "Argent", "allowedTools": ["mcp__argent__*"], "disallowedTools": ["Skill(parallax)"] },
    "A3": { "name": "Parallax", "allowedTools": ["mcp__parallax__*"] },
    "A3b3": { "name": "Parallax 0.1.0-beta.3", "allowedTools": ["mcp__parallax__*"] },
    "A3n": { "name": "Parallax (dev build, navigate)", "allowedTools": ["mcp__parallax__*"] },
    "A3n2": { "name": "Parallax (dev build, navigate + server instructions)", "allowedTools": ["mcp__parallax__*"] },
    "A3b4": { "name": "Parallax 0.1.0-beta.4", "allowedTools": ["mcp__parallax__*"] },
    "A3d": { "name": "Parallax (dev build, app_data storage)", "allowedTools": ["mcp__parallax__*"] },
    "A1b": { "name": "agent-device (the version in its path: 0.21.37 once published, else 0.21.36)", "allowedTools": ["mcp__agent-device__*"], "disallowedTools": ["Skill(parallax)"], "settings": { "skillOverrides": { "parallax": "off" } }, "path": ["tools/agent-device-0.21.36/node_modules/.bin"] },
    "A3b11": { "name": "Parallax 0.1.0-beta.11", "allowedTools": ["mcp__parallax__*"] },
    "A0r": { "name": "no device tool (rerun on the fixed harness)", "allowedTools": [], "disallowedTools": ["Skill(parallax)"], "settings": { "skillOverrides": { "parallax": "off" } } },
    "A2b": { "name": "Argent 0.32.0", "allowedTools": ["mcp__argent__*"], "disallowedTools": ["Skill(parallax)"], "settings": { "skillOverrides": { "parallax": "off" } }, "path": ["tools/argent-0.32.0/node_modules/.bin"] },
    "A2c": { "name": "Argent 0.33.0", "allowedTools": ["mcp__argent__*"], "disallowedTools": ["Skill(parallax)"], "settings": { "skillOverrides": { "parallax": "off" } }, "path": ["tools/argent-0.33.0/node_modules/.bin"] },
    "A1c": { "name": "agent-device 0.21.37", "allowedTools": ["mcp__agent-device__*"], "disallowedTools": ["Skill(parallax)"], "settings": { "skillOverrides": { "parallax": "off" } }, "path": ["tools/agent-device-0.21.37/node_modules/.bin"] },
    "A3c": { "name": "Parallax 0.1.0-beta.11 (cut-off rerun 2026-11-13)", "allowedTools": ["mcp__parallax__*"] },
    "A0c": { "name": "no device tool (cut-off rerun 2026-11-13)", "allowedTools": [], "disallowedTools": ["Skill(parallax)"], "settings": { "skillOverrides": { "parallax": "off" } } }
  }
}
